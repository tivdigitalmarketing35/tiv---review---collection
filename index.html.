    ["social", "Social Media Marketing"]
  ];

  var lang = "hn", svc = "general", idx = 0;
  var elLangs = document.getElementById("langs");
  var elSvcs = document.getElementById("svcs");
  var elDrafts = document.getElementById("drafts");
  var ta = document.getElementById("review");
  var post = document.getElementById("post");
  var copyOnly = document.getElementById("copyonly");
  var status = document.getElementById("status");

  function drawButtons(box, list, current, onPick) {
    box.innerHTML = "";
    list.forEach(function (it) {
      var b = document.createElement("button");
      b.type = "button";
      b.textContent = it[1];
      b.setAttribute("aria-pressed", it[0] === current ? "true" : "false");
      b.addEventListener("click", function () { onPick(it[0]); });
      box.appendChild(b);
    });
  }

  function drawDrafts() {
    elDrafts.innerHTML = "";
    draftsFor(lang, svc).forEach(function (t, i) {
      var b = document.createElement("button");
      b.type = "button";
      b.className = "draft";
      b.setAttribute("role", "radio");
      b.setAttribute("aria-checked", i === idx ? "true" : "false");
      var dot = document.createElement("span");
      dot.className = "dot";
      dot.setAttribute("aria-hidden", "true");
      var txt = document.createElement("span");
      txt.className = "txt";
      txt.textContent = t;
      if (lang === "hi") txt.lang = "hi";
      b.appendChild(dot);
      b.appendChild(txt);
      b.addEventListener("click", function () { idx = i; refresh(true); });
      elDrafts.appendChild(b);
    });
  }

  function refresh(loadText) {
    drawButtons(elLangs, LANGS, lang, function (v) { lang = v; idx = 0; refresh(true); });
    drawButtons(elSvcs, SVCS, svc, function (v) { svc = v; idx = 0; refresh(true); });
    drawDrafts();
    if (loadText) {
      ta.value = draftsFor(lang, svc)[idx];
      ta.lang = lang === "hi" ? "hi" : "en";
      status.textContent = "";
    }
  }

  function copyText(text, done) {
    function fallback() {
      try {
        ta.focus();
        ta.select();
        var ok = document.execCommand("copy");
        done(ok);
      } catch (e) { done(false); }
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () { done(true); }, fallback);
    } else { fallback(); }
  }

  post.addEventListener("click", function () {
    var text = ta.value.trim();
    if (!text) { status.textContent = "Google review page khul raha hai."; return; }
    copyText(text, function (ok) {
      status.textContent = ok
        ? "Review copy ho gaya. Google page par paste karein."
        : "Text select ho gaya hai. Copy karke Google page par paste karein.";
    });
  });

  copyOnly.addEventListener("click", function () {
    var text = ta.value.trim();
    if (!text) { status.textContent = "Pehle review likhein ya draft chunein."; return; }
    copyText(text, function (ok) {
      status.textContent = ok ? "Review copy ho gaya." : "Text select ho gaya hai. Ab copy karein.";
    });
  });

  refresh(true);
})();
</script>

</body></html>
