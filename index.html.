}
.status { min-height: 1.5em; margin: 0; font-size: 14px; color: var(--ok); font-weight: 500; }

.how { margin: 0; padding: 14px 14px 14px 36px; background: var(--surface); border: 1.5px solid var(--line); border-radius: 14px; font-size: 14px; color: var(--muted); }
.how li + li { margin-top: 4px; }
.how strong { color: var(--fg); font-weight: 600; }

footer { font-size: 12.5px; color: var(--muted); display: grid; gap: 4px; }

@media (prefers-reduced-motion: no-preference) {
  .draft, .chips button, .seg button, a.cta { transition: background-color .15s, border-color .15s, transform .1s; }
}
