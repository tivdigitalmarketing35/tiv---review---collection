}
.wrap { max-width: 480px; margin-inline: auto; display: grid; gap: 26px; }
button, a.cta { font: inherit; }
:focus-visible { outline: 3px solid var(--glow); outline-offset: 2px; }

/* brand */
.brand { display: flex; align-items: center; gap: 14px; }
.logo { width: 60px; height: 60px; flex: none; display: block; border-radius: 14px; object-fit: cover; box-shadow: 0 0 0 1.5px var(--line); }
.brand b { display: block; font-family: var(--font-display); font-size: 20px; line-height: 1.1; font-weight: 700; }
.brand span { display: block; font-size: 13px; color: var(--muted); letter-spacing: 0.02em; }

/* hero */
h1 {
  margin: 0 0 8px; font-family: var(--font-display); font-weight: 700;
  font-size: clamp(28px, 8vw, 36px); line-height: 1.12; text-wrap: balance;
}
.lede { margin: 0; color: var(--muted); max-width: 46ch; }

/* steps */
.step { display: grid; gap: 12px; min-width: 0; }
.step h2 {
  margin: 0; display: flex; align-items: center; gap: 10px;
  font-size: 15px; font-weight: 600; letter-spacing: 0.01em;
}
.num {
  width: 24px; height: 24px; flex: none; border-radius: 50%;
  display: grid; place-items: center; font-size: 13px; font-weight: 600;
  background: var(--accent); color: var(--accent-fg);
}

.seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; padding: 4px; background: var(--surface); border: 1.5px solid var(--line); border-radius: 14px; }
.seg button {
  min-height: 44px; border: 0; border-radius: 10px; background: transparent;
  color: var(--muted); font-weight: 600; cursor: pointer;
}
.seg button[aria-pressed="true"] { background: var(--royal); color: #fff; }

.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chips button {
  min-height: 40px; padding: 0 14px; border-radius: 999px; cursor: pointer;
  background: var(--surface); color: var(--fg); border: 1.5px solid var(--line); font-weight: 500; font-size: 15px;
}
.chips button[aria-pressed="true"] { border-color: var(--accent); background: var(--surface-2); color: var(--fg); box-shadow: inset 0 0 0 1px var(--accent); }

.drafts { display: grid; gap: 10px; }
.draft {
  display: flex; gap: 12px; align-items: flex-start; text-align: left; width: 100%;
  padding: 14px; border-radius: 14px; cursor: pointer; color: var(--fg);
  background: var(--surface); border: 1.5px solid var(--line);
}
.draft .dot {
  width: 20px; height: 20px; flex: none; margin-top: 3px; border-radius: 50%;
  border: 2px solid var(--muted);
}
.draft .txt { min-width: 0; font-size: 15px; line-height: 1.6; }
.draft[aria-checked="true"] { border-color: var(--glow); background: var(--surface-2); }
.draft[aria-checked="true"] .dot { border-color: var(--accent); background: radial-gradient(circle, var(--accent) 0 45%, transparent 50%); }

textarea {
  width: 100%; min-height: 170px; resize: vertical; padding: 14px;
  border-radius: 14px; border: 1.5px solid var(--line); background: var(--surface); color: var(--fg);
  font: inherit; font-size: 16px; line-height: 1.6;
}
textarea::placeholder { color: var(--muted); }
.hint { margin: 0; font-size: 13px; color: var(--muted); }

/* action */
.action { display: grid; gap: 12px; }
a.cta {
  display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px;
  padding: 0 18px; border-radius: 14px; text-decoration: none;
