  color-scheme: dark;
}
@media (prefers-color-scheme: light) {
  :root:not([data-theme="dark"]) {
    --bg: #f5f0ff; --surface: #ffffff; --surface-2: #eadfff; --fg: #1e0f55; --muted: #5b4a94;
    --line: #d5c6f6; --accent: #f26e05; --accent-fg: #241100; --glow: #5b2bd6; --royal: #5b2bd6; --ok: #12804a;
    color-scheme: light;
  }
}
:root[data-theme="light"] {
  --bg: #f5f0ff; --surface: #ffffff; --surface-2: #eadfff; --fg: #1e0f55; --muted: #5b4a94;
  --line: #d5c6f6; --accent: #f26e05; --accent-fg: #241100; --glow: #5b2bd6; --royal: #5b2bd6; --ok: #12804a;
  color-scheme: light;
}

* { box-sizing: border-box; }
body {
